# Copy to .env and fill in. Without a key the app runs in offline "demo tutor" mode.
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
PORT=8787
# Protect a public deployment with a shared password (browser login prompt, any username)
APP_PASSWORD=
